  backgroundSprite: {fileID: 21300000, guid: abd44a56e231e784e89759d5e86161d7, type: 3}
  dialogues:
  - "\u201COnce, the king believed in miracles\u2026 in magic, and the gods who watched
    over men.\n But after the night the stars fell \u2014 after the old fire consumed
    his court \u2014 faith turned to fear.\u201D"
  - "\u201CAnd so, when whispers rose from the eastern vale \u2014 of witches who
    worship the forgotten goddess, Nyx\u201D \u2014\n\u201CKing Theon called upon
    his last hope.\u201D"
